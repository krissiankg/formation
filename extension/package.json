{
  "name": "forgeia-code",
  "displayName": "FORGEIA CODE",
  "description": "L'assistant de code IA de la formation FORGE IA : modes de la méthode ADAPT, crédit IA inclus, modèles de projets et aperçu dans le navigateur interne. Propulsé par Kilo Code.",
  "version": "2.0.0",
  "publisher": "guelichweb",
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://forgeia.guelichweb.store",
  "repository": {
    "type": "git",
    "url": "https://github.com/krissiankg/formation.git",
    "directory": "extension"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Education"
  ],
  "keywords": [
    "forge ia",
    "forgeia",
    "adapt",
    "kilo code",
    "deepseek",
    "formation"
  ],
  "extensionDependencies": [
    "kilocode.kilo-code"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forgeia.connect",
        "title": "Connecter mon compte",
        "category": "FORGE IA"
      },
      {
        "command": "forgeia.enterKey",
        "title": "Saisir ma clé",
        "category": "FORGE IA"
      },
      {
        "command": "forgeia.signOut",
        "title": "Se déconnecter",
        "category": "FORGE IA"
      },
      {
        "command": "forgeia.menu",
        "title": "Menu FORGE IA",
        "category": "FORGE IA"
      },
      {
        "command": "forgeia.dailyExercise",
        "title": "Exercice du jour",
        "category": "FORGE IA"
      },
      {
        "command": "forgeia.preview",
        "title": "Aperçu dans le navigateur interne",
        "category": "FORGE IA"
      },
      {
        "command": "forgeia.newProject",
        "title": "Nouveau projet de la formation",
        "category": "FORGE IA"
      }
    ],
    "configuration": {
      "title": "FORGEIA CODE",
      "properties": {
        "forgeia.siteUrl": {
          "type": "string",
          "default": "https://forgeia.guelichweb.store",
          "description": "Adresse de la plateforme FORGE IA (à modifier seulement pour les tests)."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "start",
        "title": "Démarrer avec FORGEIA CODE",
        "description": "Connecte ton compte, choisis un mode ADAPT et lance ton premier projet.",
        "steps": [
          {
            "id": "connect",
            "title": "Connecter mon compte FORGE IA",
            "description": "Relie FORGEIA CODE à ton crédit IA.\n[Connecter mon compte](command:forgeia.connect)",
            "media": {
              "markdown": "walkthrough/1-connecter.md"
            },
            "completionEvents": [
              "onCommand:forgeia.connect"
            ]
          },
          {
            "id": "modes",
            "title": "Choisir un mode ADAPT dans Kilo Code",
            "description": "Six modes pour apprendre en codant.",
            "media": {
              "markdown": "walkthrough/2-modes.md"
            }
          },
          {
            "id": "project",
            "title": "Créer le projet de la semaine",
            "description": "Un modèle prêt pour chaque projet de la formation.\n[Nouveau projet](command:forgeia.newProject)",
            "media": {
              "markdown": "walkthrough/3-projet.md"
            },
            "completionEvents": [
              "onCommand:forgeia.newProject"
            ]
          },
          {
            "id": "preview",
            "title": "Voir le résultat dans le navigateur interne",
            "description": "Ton site, sans quitter VS Code.\n[Ouvrir l'aperçu](command:forgeia.preview)",
            "media": {
              "markdown": "walkthrough/4-apercu.md"
            },
            "completionEvents": [
              "onCommand:forgeia.preview"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.105.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
