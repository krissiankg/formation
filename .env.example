# Copie ce fichier en .env.local et renseigne les valeurs utiles.
# Sans clé, chaque service passe en mode démo en local : rien n'est encaissé ni envoyé.
# En production, ces valeurs viennent d'AWS Secrets Manager : ne versionne jamais de vraie clé.

# Redirection des anciens domaines vers www.forgeia.site (production uniquement).
LEGACY_DOMAIN_REDIRECTS=false

# Supabase : obligatoire pour toutes les pages sauf l'accueil.
NEXT_PUBLIC_SUPABASE_URL=https://<projet>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Connexion au tableau de bord /admin (voir deploy/admin-auth.md).
# Hash : node scripts/hash-admin-password.mjs "ton-mot-de-passe"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# FedaPay. Sans clé : paiement simulé en local, refusé en production.
FEDAPAY_SECRET_KEY=
FEDAPAY_ENV=sandbox
FEDAPAY_WEBHOOK_SECRET=

# E-mails via Brevo. Sans clé : les e-mails s'affichent dans la console.
BREVO_API_KEY=
EMAIL_FROM="FORGE IA <notifications@forgeia.site>"

# Alertes du formateur sur Telegram (facultatif).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bibliothèque de ressources Google Drive (facultatif).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_COLLECTION_OWNER=

# Fichiers envoyés sur Amazon S3 (facultatif ; sinon sur le disque local).
UPLOADS_BUCKET=
AWS_REGION=eu-west-3

# Aperçus publics des modèles de sites de la boutique (facultatif).
WEBSITE_EXAMPLES_PREVIEW_BASE_URL=
